<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <TextView
        android:id="@+id/cart_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/jdk"
        android:drawableLeft="@drawable/user"
        android:drawableRight="@drawable/message"
        android:gravity="center"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="商品分类"
        android:textColor="@color/colorBlack"
        android:textSize="24sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_type"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:layout_below="@+id/cart_title"
        android:layout_alignParentLeft="true"
        android:background="@drawable/jdk12"
        android:orientation="vertical"
        >

        <RadioButton
            android:id="@+id/rb_commf1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="推荐分类"
            android:textSize="15dp" />

        <RadioButton
            android:id="@+id/rb_commf2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rb_commf1"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="智购超市"
            android:textSize="15dp" />

        <RadioButton
            android:id="@+id/rb_commf3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rb_commf2"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="国际品牌"
            android:textSize="15dp" />

        <RadioButton
            android:id="@+id/rb_commf4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rb_commf3"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="男 装"
            android:textSize="15dp" />

        <RadioButton
            android:id="@+id/rb_commf5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rb_commf4"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="女 装"
            android:textSize="15dp" />

        <RadioButton
            android:id="@+id/rb_commf6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rb_commf5"
            android:width="60dp"
            android:height="50dp"

            android:button="@null"
            android:gravity="center"
            android:text="手机数码"
            android:textSize="15dp" />
    </RadioGroup>

    <FrameLayout
        android:id="@+id/frameLayout_type"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cart_title"
        android:layout_toRightOf="@+id/rg_type"
        android:layout_weight="1"
        android:background="@drawable/jdk12"
        tools:ignore="Suspicious0dp" />

</RelativeLayout>
