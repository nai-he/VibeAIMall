<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/jdk2"
    >

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp"
        android:layout_width="match_parent"
        android:layout_height="250dp"></androidx.viewpager2.widget.ViewPager2>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignBottom="@id/vp"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="新品颁布推荐购买"
            android:textColor="@color/colorBlack" />

        <LinearLayout
            android:id="@+id/layout_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"></LinearLayout>
    </LinearLayout>

    <!-- HelloWorld TextView outside the LinearLayout -->
    <TextView
        android:id="@+id/back_home"
        android:layout_width="wrap_content"

        android:layout_height="wrap_content"
        android:layout_below="@id/vp"
        android:layout_marginTop="0dp"
        android:text="       尊敬的顾客们，
随着季节的变换，Vibe智购节如约而至，我们为您带来了一场智能购物体验。作为 AI 购物助手，Vibe智购致力于提供更贴近场景的商品和服务，让每一次选择都有清晰理由。

在这个特别的日子里，我们精心准备了丰富的商品种类，从尖端科技的电子产品到温馨舒适的家居用品，从时尚潮流的服饰鞋包到健康美味的食品生鲜，Vibe智购会围绕预算、场景和偏好帮你做出更稳的选择。

我们深知价格是您关心的重点，因此在 Vibe智购节期间，我们会优先呈现高性价比选择，并用推荐理由说明为什么它适合当前需求。

Vibe智购关注从推荐到下单的完整体验，订单状态、评价和售后流程都可以在 App 内闭环演示。

在 Vibe智购，我们不仅关注商品交易，更重视用户需求是否被准确理解、推荐是否可解释、动作是否能顺畅完成。

结语：
Vibe智购节，不仅是一次购物体验，更是一次 AI 原生产品闭环展示。立即开启智能购物之旅，体验不一样的购物决策方式！

Vibe智购团队敬上"
        android:textColor="@android:color/black" /> <!-- Position HelloWorld below the ViewPager2 -->

</RelativeLayout>
