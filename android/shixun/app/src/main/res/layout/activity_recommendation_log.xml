<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0F766E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/log_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="AI 推荐记录"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/log_clear"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="清空"
            android:textColor="#CCFBF1"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/log_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:text="展示 AI 推荐、加购动作和需求识别记录"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/log_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E5E7EB"
        android:dividerHeight="1dp"
        android:padding="10dp" />

    <TextView
        android:id="@+id/log_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="暂无推荐记录\n去 AI 助手生成一次推荐即可看到闭环日志"
        android:textColor="#666666"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>
