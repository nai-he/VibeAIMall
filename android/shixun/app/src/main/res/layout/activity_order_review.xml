<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0F766E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/review_back"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="发表评价"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="56dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/bg_ai_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/review_goods_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside"
            android:src="@drawable/c101" />

        <TextView
            android:id="@+id/review_goods_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="商品名称"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/review_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:numStars="5"
            android:rating="5"
            android:stepSize="0.5" />

        <EditText
            android:id="@+id/review_content"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/edittext_border"
            android:gravity="top"
            android:hint="写下真实体验，例如：推荐理由是否准确、商品是否符合场景需求"
            android:padding="10dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/review_submit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_order_action"
            android:text="提交评价"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
